DATABASE_URL=sqlite:///./runtime/data/app.db
APP_NAME=momo-trading
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# === 브로커 선택 / KIS MCP 서버 ===
# start.sh 자동 분기 기준은 계좌값이 아니라 BROKER_PROVIDER 입니다.
# - KIS    -> kis-mcp 자동 기동
# - KIWOOM -> 실행 중인 kis-mcp 자동 중지
KIS_MCP_URL=http://localhost:3100/sse
BROKER_PROVIDER=KIS

# KIS API 인증 (MCP Docker에 전달)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_HTS_ID=
KIS_ACCT_STOCK=
KIS_PAPER_STOCK=
KIS_PROD_TYPE=01
KIS_ACCOUNT_TYPE=VIRTUAL

# KIS WebSocket
KIS_WS_URL_DOMESTIC=ws://ops.koreainvestment.com:21000
KIS_WS_URL_OVERSEAS=ws://ops.koreainvestment.com:31000

# === Kiwoom REST API ===
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_SECRET_KEY=
KIWOOM_ACCOUNT_TYPE=VIRTUAL

# === AI / LLM (Claude Code CLI / Codex CLI) ===
LLM_PROVIDER=CLAUDE_CODE              # CLAUDE_CODE | CODEX
LLM_PROVIDER_TIER1=                   # 비어있으면 LLM_PROVIDER 사용
LLM_PROVIDER_TIER2=                   # 비어있으면 LLM_PROVIDER 사용
LLM_FALLBACK_PROVIDER_TIER1=          # CLAUDE_CODE | CODEX | 비움
LLM_FALLBACK_PROVIDER_TIER2=
LLM_FALLBACK_MODEL_TIER1=DEFAULT      # fallback provider 모델/버전
LLM_FALLBACK_MODEL_TIER2=DEFAULT
MANUAL_LLM_PROVIDER=AUTOMATIC         # AUTOMATIC | CLAUDE_CODE | CODEX

CLAUDE_CODE_MODEL=DEFAULT             # DEFAULT=CLI 기본값 사용
CLAUDE_CODE_MODEL_TIER1=DEFAULT       # 예: haiku / sonnet / claude-sonnet-4-6
CLAUDE_CODE_MODEL_TIER2=DEFAULT       # 예: opus / claude-opus-4-6
# CLAUDE_CODE_PATH=/opt/homebrew/bin/claude  # 비어있으면 자동 탐색

CODEX_MODEL=DEFAULT                   # DEFAULT=CLI 기본값 사용
CODEX_MODEL_TIER1=DEFAULT             # 예: gpt-5-codex / gpt-5.1-codex-max
CODEX_MODEL_TIER2=DEFAULT             # 예: gpt-5-codex / gpt-5.4
# CODEX_PATH=/opt/homebrew/bin/codex   # 비어있으면 자동 탐색

# === AI Agent ===
AUTONOMY_MODE=SEMI_AUTO
RECOMMENDATION_EXPIRE_MIN=60
MIN_BUY_QUANTITY=1

# === Trading Safety ===
TRADING_ENABLED=false
DAY_TRADING_ONLY=false                # true=당일 청산 필수, false=스윙 (유망 종목 오버나이트)
MAX_HOLD_DAYS_STABLE=5               # STABLE_SHORT 최대 보유일
MAX_HOLD_DAYS_AGGRESSIVE=3           # AGGRESSIVE_SHORT 최대 보유일
MAX_DAILY_TRADES=30
# MAX_SINGLE_ORDER_KRW / MAX_SINGLE_ORDER_USD: 미설정 시 AI 자율 결정
BUY_ORDER_EXECUTION_MODE=LIMIT_GUARD   # LIMIT_GUARD | MARKET
BUY_SLIPPAGE_GUARD_BPS=20              # LIMIT_GUARD 시 허용 슬리피지(bp)
AUTO_RISK_KILL_SWITCH_ENABLED=true
MAX_DAILY_DRAWDOWN_PCT=2.5
MAX_CONSECUTIVE_LOSSES=4
MIN_STRATEGY_EXPECTANCY=0.0
EXPECTANCY_SAMPLE_SIZE=12
VOLATILITY_POSITION_SIZING_ENABLED=true
RISK_PER_TRADE_PCT=0.5                 # 1회 거래 허용 리스크 (% of total asset)
RISK_MULTIPLIER_SHORT=0.7
RISK_MULTIPLIER_MID=1.0
RISK_MULTIPLIER_LONG=1.2
COST_GATE_ENABLED=true
ESTIMATED_ENTRY_COST_BPS=8
ESTIMATED_EXIT_COST_BPS=8
ESTIMATED_SLIPPAGE_BPS_SHORT=12
ESTIMATED_SLIPPAGE_BPS_MID=8
ESTIMATED_SLIPPAGE_BPS_LONG=6
MIN_EDGE_TO_COST_RATIO_SHORT=1.5
MIN_EDGE_TO_COST_RATIO_MID=1.3
MIN_EDGE_TO_COST_RATIO_LONG=1.1

# === AI Risk Tuning ===
AI_RISK_TUNING_ENABLED=true
RISK_APPETITE=MODERATE
MIN_CASH_RATIO=0.05              # 최소 현금 비중 (0.05 = 5%, 빠른 대응용 여유금)

# === Scheduler ===
SCHEDULER_ENABLED=true
